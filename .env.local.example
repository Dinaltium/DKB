# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — secrets must stay out of git history.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon or Supabase pooled connection) ────────────────────────────
# Neon:     postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Supabase: postgresql://USER:PASSWORD@HOST:6543/DB?sslmode=require
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Auth.js v5 ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Used by NextAuth AND by the ticket QR HMAC — keep it secret and rotate carefully.
AUTH_SECRET="replace-with-openssl-rand-base64-32-output"

# ── Google OAuth (optional — leave blank to disable Google sign-in) ──────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorised redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "true" in production behind a non-Vercel proxy.
AUTH_TRUST_HOST="false"

# ── Seeding (used by scripts/seed.ts) ────────────────────────────────────────
# Each role is optional — leave a block blank to skip it.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme"
SEED_ADMIN_NAME="Admin"

SEED_OPERATOR_EMAIL="operator@example.com"
SEED_OPERATOR_PASSWORD="changeme"
SEED_OPERATOR_COMPANY="Example Bus Co"
SEED_OPERATOR_PHONE=""
SEED_OPERATOR_APPROVED="true"

SEED_CONDUCTOR_EMAIL="conductor@example.com"
SEED_CONDUCTOR_PASSWORD="changeme"
SEED_CONDUCTOR_NAME="Conductor"

SEED_PASSENGER_EMAIL="passenger@example.com"
SEED_PASSENGER_PASSWORD="changeme"
SEED_PASSENGER_NAME="Passenger"
SEED_PASSENGER_PHONE=""

# ── GPS Simulation ───────────────────────────────────────────────────────────
# "true" to show fake bus movement on maps/dashboards; set "false" in production.
NEXT_PUBLIC_ENABLE_FAKE_MOVEMENT="false"

NEXT_PUBLIC_PAYMENT_MODE=mock
