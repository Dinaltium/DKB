# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ─────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build output (Next.js) ───────────────────────────────────────────────────
/.next/
/.nextwin/
/.next_dir
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ── Test reports ─────────────────────────────────────────────────────────────
/coverage/
/playwright-report/
/test-results/

# ── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ── Env & secrets ────────────────────────────────────────────────────────────
.env
.env.*
!.env.local.example
*.pem
credentials.txt
*.key
*.crt

# ── OS / Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── Deployment / vendor ──────────────────────────────────────────────────────
.vercel
.netlify

# ── Geocoding / OCR scratch artefacts (one-off scripts) ──────────────────────
locations_failed.json
locations_with_coords.json
geocode_log.csv
app.py
fix_csv.py
seed-stops.sql

# ── Reference checkout ───────────────────────────────────────────────────────
BusLink/

# ── PWA generated assets ─────────────────────────────────────────────────────
/public/sw.js
/public/workbox-*.js
/public/swe-worker-*.js

# ── Claude / agent metadata ──────────────────────────────────────────────────
.claude/

# ── Capacitor / Android build outputs ────────────────────────────────────────
# We track the android/ project source (build.gradle, manifests, etc.) but
# never the build artefacts, IDE config, or signing material.
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.cxx/
android/app/release/
*.jks
*.keystore
google-services.json
# Capacitor copies the web app into the Android tree on every sync — these
# files are derived, never edited by hand.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json


# Firecrawl scrape scratch
.firecrawl/
