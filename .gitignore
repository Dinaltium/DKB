/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build output (Next.js) ───────────────────────────────────────────────────
/.next/
/.nextwin/
/.next_dir
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ── Test reports ─────────────────────────────────────────────────────────────
/coverage/
/playwright-report/
/test-results/

# ── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ── Env & secrets ────────────────────────────────────────────────────────────
.env
.env.*
!.env.local.example
*.pem
credentials.txt
*.key
*.crt

# ── OS / Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── Deployment / vendor ──────────────────────────────────────────────────────
.vercel
.netlify

# ── Geocoding / OCR scratch artefacts (one-off scripts) ──────────────────────
locations_failed.json
locations_with_coords.json
geocode_log.csv
app.py
fix_csv.py
seed-stops.sql

# ── Reference checkout ───────────────────────────────────────────────────────
BusLink/

# ── PWA generated assets ─────────────────────────────────────────────────────
/public/sw.js
/public/workbox-*.js
/public/swe-worker-*.js

# ── Claude / agent metadata ──────────────────────────────────────────────────
.claude/
